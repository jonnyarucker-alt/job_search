# Copy this file to `.env` (which is gitignored) and fill in your values.
# Use a Gmail APP PASSWORD, not your normal account password:
#   1. Enable IMAP:  Gmail Settings -> Forwarding and POP/IMAP -> Enable IMAP
#   2. App password: https://myaccount.google.com/apppasswords (needs 2-Step Verification)

GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional: IMAP host/folder overrides (defaults shown)
# IMAP_HOST=imap.gmail.com
# IMAP_FOLDER=[Gmail]/All Mail
